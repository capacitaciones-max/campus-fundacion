rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Función auxiliar para verificar si es Administrador Principal
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email.lower() == 'sole.petetta@gmail.com' || 
        request.auth.token.email.lower() == 'capacitaciones@fundacioncrucianelli.com'
      );
    }

    // Función auxiliar para verificar si es docente o administrador
    function isTeacher() {
      return request.auth != null && (
        isAdmin() ||
        exists(/databases/$(database)/documents/teachers/$(request.auth.token.email.lower())) ||
        exists(/databases/$(database)/documents/teachers/$(request.auth.token.email))
      );
    }

    // Reglas para el foro
    match /forum/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (isTeacher() || request.auth.uid == resource.data.authorId);
    }

    // Reglas para los módulos y sus archivos
    match /modules/{moduleId} {
      allow read: if true;
      allow write: if isTeacher();
      
      match /files/{fileId} {
        allow read: if true;
        allow write: if isTeacher();
      }
    }

    // Reglas para el contenido binario/base64 de archivos
    match /file_contents/{fileId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // Reglas para la lista de alumnos (Solo Admins pueden modificar)
    match /students/{email} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Reglas para la lista de docentes (Solo Admins pueden modificar)
    match /teachers/{email} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Reglas para el progreso del usuario
    match /progress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Permitir lectura de metadatos del proyecto si fuera necesario
    match /_info_/{docId} {
      allow read: if true;
    }
  }
}
